# Declarative package list for mac-bootstrap.
# Run with: brew bundle --file=Brewfile

# --- Shell & prompt ---
brew "fish"
brew "starship"

# --- Terminal & font ---
cask "ghostty"
cask "font-maple-mono-nf"
cask "font-maple-mono-nf-cn"

# --- Core modern CLI ---
brew "fd"           # find replacement
brew "eza"          # ls replacement
brew "bat"          # cat replacement
brew "ripgrep"      # grep replacement (rg)
brew "fzf"          # fuzzy finder
brew "zoxide"       # smart cd (z)
brew "sad"          # sed replacement
brew "jq"           # JSON processor
brew "httpie"       # curl replacement
brew "git-delta"    # git diff viewer

# --- Git & GitHub ---
brew "git"
brew "gh"
brew "lazygit"

# --- File managers & TUIs ---
brew "yazi"
brew "zellij"

# --- System monitoring ---
brew "btop"
brew "dust"         # du replacement
brew "procs"        # ps replacement
brew "hyperfine"    # benchmarking
brew "fastfetch"

# --- Docs & misc ---
brew "tealdeer"     # tldr client (Rust)
brew "glow"         # markdown in terminal
brew "tailspin"     # log highlighter (tspin)
brew "tokei"        # code stats
brew "chezmoi"      # dotfile manager (for later)

# --- Editors ---
brew "neovim"

# --- Language runtimes & managers ---
brew "pyenv"
brew "uv"           # Python project/tool manager
brew "pnpm"
brew "bun"

# --- Wizard UI (used by future interactive mode) ---
brew "gum"
